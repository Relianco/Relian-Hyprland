/* Omarchy-style input-only box (no list). */
@import "~/.config/rofi/config-omarchy-launcher.rasi"

configuration { modi: "dmenu"; }
window { width: 560px; }
mainbox { children: [ inputbar, message ]; }
entry { placeholder: "Search the web"; }
listview { enabled: false; }
