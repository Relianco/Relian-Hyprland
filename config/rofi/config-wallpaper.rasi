/* ---- Relian-Hyprland ---- */
/* Omarchy-style wallpaper picker: square thumbnails in a 4-column grid (fixed size, so it looks the same on a 5120px monitor). */
@import "~/.config/rofi/config-omarchy-launcher.rasi"

configuration { modi: "drun"; }
window { width: 1500px; }
mainbox { children: [ inputbar, message, listview ]; }
message { padding: 4px 10px; }
entry { placeholder: "Choose wallpaper"; }
listview { columns: 4; lines: 2; spacing: 16px; fixed-columns: true; flow: horizontal; scrollbar: false; }
element { orientation: vertical; padding: 8px; spacing: 6px; border: 2px; border-color: transparent; }
element-icon { size: 330px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; text-color: rgba(255, 255, 255, 60%); }
element selected.normal { background-color: transparent; border-color: @active-background; }
element selected.normal element-text { text-color: @normal-foreground; }
